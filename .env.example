# Required (no default): development | test | production. The server refuses to boot without it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3006
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public SPA URL (email links, CSP). Required (https) in production; defaults to http://localhost:5173.
APP_BASE_URL=http://localhost:5173
# Comma-separated exact origins for CORS and the CSRF Origin check. Defaults to APP_BASE_URL's origin.
CORS_ORIGIN=http://localhost:5173
# Extra origins allowed only outside production (Vite dev server).
# DEV_ALLOWED_ORIGINS=http://localhost:5173
# true | false | hop count | comma-separated addresses/CIDRs. Defaults to "loopback" in production, false otherwise.
# TRUST_PROXY=loopback
# Production doesn't use env vars for secrets (DATABASE_URL, JWT_SECRET, RESEND_API_KEY, S3 keys): systemd sets
# CREDENTIALS_DIRECTORY (LoadCredential=), and config.ts reads one file per key from it. Unset here = env only.
# A key may come from env OR a credential file, never both.
# Local dev database from `scripts/dev-db.sh up` (podman, port 55433, named volume, dev-only credentials).
DATABASE_URL=postgresql://cuencada:cuencada-dev@127.0.0.1:55433/cuencada
# Disposable test cluster from `scripts/test-db.sh up` (Vitest clones per-worker DBs from it)
TEST_DATABASE_URL=postgresql://cuencada:cuencada@127.0.0.1:55432/cuencada_test
# At least 32 characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-vault
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
# Defaults to true in production, false otherwise (plain-http localhost).
# COOKIE_SECURE=false
# Email (Resend). Required in production. Without them the dev mailer sends nothing: under NODE_ENV=development
# it prints each email (recipient, subject, plain text with the invite/magic-link/verify/reset links) to the
# server's terminal; under test it logs {to, subject} only. It refuses to run in production.
# RESEND_API_KEY=
# MAIL_FROM=Cuencada <no-reply@cuencada.com>
SUPPORT_EMAIL=admin@cuencada.com
# true = new gallery uploads need admin approval before members see them.
MEDIA_REQUIRE_APPROVAL=false
# Breached-password check on invite accept, change and reset (HIBP k-anonymity: only a
# 5-char SHA-1 prefix leaves the server). on|off; defaults to on (off under NODE_ENV=test).
# Fails open (allows the password, logs password.breach_check_unavailable) if the API is unreachable.
PASSWORD_BREACH_CHECK=on
# Reject a password seen in at least this many breaches (ASVS default 1).
PASSWORD_BREACH_MIN_COUNT=1
SEED_ADMIN_EMAIL=admin@cuencada.com
# Empty in development/test: the seed falls back to Password123! (forced change at first login).
# Production requires a strong one (>= 16 chars, not a placeholder, not breached) from the vault.
SEED_ADMIN_TEMP_PASSWORD=
# Development only: 1 marks the seeded admin's email as verified (also on a re-run), so member pages open
# without the "Verifica tu correo" step. The seed refuses it when NODE_ENV is not development.
SEED_DEV_VERIFY_ADMIN=
# Member-only links for the seeded 2026 Cuencada (https only). Outside development/test ALL FOUR are required
# (vault values, rotated at cutover, never committed): links only reach the edition on the seed's first run.
# SEED_ALLOW_MISSING_LINKS=true skips that check for a deliberate re-run.
# In development/test, unset falls back to example.com placeholders.
# SEED_WHATSAPP_URL=
# SEED_EXTERNAL_ALBUM_URL=
# SEED_LYRICS_URL=
# SEED_PROGRAM_URL=
# SEED_ALLOW_MISSING_LINKS=
# Optional: migrator target (falls back to DATABASE_URL). Production: the OWNER role through the DB tunnel
# (infra/db/roles.sql); DATABASE_URL on the VPS is the least-privilege runtime role.
MIGRATE_DATABASE_URL=postgresql://cuencada:cuencada-dev@127.0.0.1:55433/cuencada
# Optional: override the daily-messages file the seed imports (defaults to the repo-root mensajes.txt)
# SEED_DAILY_MESSAGES_FILE=
S3_ENDPOINT=https://us-east-1.linodeobjects.com
S3_REGION=us-east-1
S3_BUCKET=cuencada
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
VITE_API_BASE_URL=/api
# Bucket origin that presigned upload URLs must match exactly (scheme + host + port, no path); https only in
# production. Use the host the server's presigner emits (path-style endpoint or the bucket's virtual host).
# Unset = gallery uploads are refused. Not a secret.
VITE_MEDIA_UPLOAD_ORIGIN=https://cuencada.us-east-1.linodeobjects.com

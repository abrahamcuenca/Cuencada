# Required (no default): development | test | production. The server refuses to boot without it.
NODE_ENV=development
HOST=127.0.0.1
PORT=3006
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Public SPA URL (email links, CSP). Required (https) in production; defaults to http://localhost:5173.
APP_BASE_URL=http://localhost:5173
# Comma-separated exact origins for CORS and the CSRF Origin check. Defaults to APP_BASE_URL's origin.
CORS_ORIGIN=http://localhost:5173
# Extra origins allowed only outside production (Vite dev server).
# DEV_ALLOWED_ORIGINS=http://localhost:5173
# true | false | hop count | comma-separated addresses/CIDRs. Defaults to "loopback" in production, false otherwise.
# TRUST_PROXY=loopback
DATABASE_URL=postgresql://cuencada:cuencada@127.0.0.1:5432/cuencada
# Disposable test cluster from `scripts/test-db.sh up` (Vitest clones per-worker DBs from it)
TEST_DATABASE_URL=postgresql://cuencada:cuencada@127.0.0.1:55432/cuencada_test
# At least 32 characters in production (e.g. `openssl rand -base64 48`).
JWT_SECRET=change-me-in-vault
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_IDLE_DAYS=30
REFRESH_ABSOLUTE_DAYS=90
# Defaults to true in production, false otherwise (plain-http localhost).
# COOKIE_SECURE=false
# Email (Resend). Required in production; without them development logs {to, subject} only.
# RESEND_API_KEY=
# MAIL_FROM=Cuencada <no-reply@cuencada.com>
SUPPORT_EMAIL=admin@cuencada.com
# true = new gallery uploads need admin approval before members see them.
MEDIA_REQUIRE_APPROVAL=false
SEED_ADMIN_EMAIL=admin@cuencada.com
# The seed refuses this placeholder (and any password < 16 chars) unless NODE_ENV is development or test.
SEED_ADMIN_TEMP_PASSWORD=replace-with-vault-value
# Optional member-only links for the seeded 2026 Cuencada (https only). Outside development/test they are
# seeded ONLY from these vars (vault values, rotated at cutover, never committed); unset = not seeded.
# In development/test, unset falls back to the legacy public links.
# SEED_WHATSAPP_URL=
# SEED_EXTERNAL_ALBUM_URL=
# SEED_LYRICS_URL=
# SEED_PROGRAM_URL=
# Optional: migrator target (falls back to DATABASE_URL); set explicitly for production via the DB tunnel
# MIGRATE_DATABASE_URL=
# Optional: override the daily-messages file the seed imports (defaults to the repo-root mensajes.txt)
# SEED_DAILY_MESSAGES_FILE=
S3_ENDPOINT=https://us-southeast-1.linodeobjects.com
S3_REGION=us-southeast-1
S3_BUCKET=cuencada
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
VITE_API_BASE_URL=/api

{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["HOST", "PORT", "LOG_LEVEL", "APP_BASE_URL", "CORS_ORIGIN", "DEV_ALLOWED_ORIGINS", "CUENCADA_DEV_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "cache": false,
      "outputs": []
    }
  }
}

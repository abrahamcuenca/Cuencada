{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "paths": {
      "vite": ["../../apps/web/node_modules/vite"]
    }
  },
  "include": ["./**/*.ts", "../../playwright.config.ts"],

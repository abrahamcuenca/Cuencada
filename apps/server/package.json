{
  "name": "@cuencada/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node dist/db/migrate.js",
    "db:migrate:dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/db/migrate.ts",
    "db:seed": "node dist/seed.js",
    "db:seed:dev": "tsx --env-file-if-exists=../../.env --env-file-if-exists=.env src/seed.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "test": "vitest run --config ../../vitest.config.ts --project server"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.890.0",
    "@aws-sdk/s3-request-presigner": "^3.890.0",
    "@cuencada/emails": "workspace:*",
    "@cuencada/types": "workspace:*",
    "@fastify/cookie": "^11.1.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/websocket": "^11.3.1",
    "argon2": "^0.44.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.0",
    "fastify-type-provider-zod": "^7.0.0",
    "jose": "^6.1.0",
    "postgres": "^3.4.7",
    "resend": "^6.30.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "drizzle-kit": "^0.31.7",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.20.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
